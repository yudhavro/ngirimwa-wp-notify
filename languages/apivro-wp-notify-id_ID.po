msgid "API Key is not set."
msgstr "API Key belum diisi."

#: includes/class-apivro-wp-notify-api.php:166
#, php-format
msgid "Unexpected response from NgirimWA (HTTP %d)."
msgstr "Respons tidak terduga dari NgirimWA (HTTP %d)."

#: includes/class-apivro-wp-notify.php:76
msgid "Sending is paused. Fix the problem shown in the settings page."
msgstr "Pengiriman dijeda. Perbaiki masalah yang tampil di halaman pengaturan."

#: includes/class-apivro-wp-notify.php:101
msgid "Sending is paused."
msgstr "Pengiriman dijeda."

#: includes/class-apivro-wp-notify.php:133
#, php-format
msgid "%1$s — retrying in %2$d minute(s)."
msgstr "%1$s — dicoba lagi dalam %2$d menit."

#: includes/class-apivro-wp-notify.php:234
msgid "API Key is invalid or was deleted. Create a new key in the NgirimWA dashboard."
msgstr "API Key tidak valid atau sudah dihapus. Buat key baru di dashboard NgirimWA."

#: includes/class-apivro-wp-notify.php:235
msgid "API Key is inactive. Activate it in the NgirimWA dashboard."
msgstr "API Key nonaktif. Aktifkan di dashboard NgirimWA."

#: includes/class-apivro-wp-notify.php:236
msgid "Your NgirimWA subscription is not active."
msgstr "Langganan NgirimWA Anda tidak aktif."

#: includes/class-apivro-wp-notify.php:237
msgid "Your NgirimWA account is suspended. Contact support."
msgstr "Akun NgirimWA Anda ditangguhkan. Hubungi support."

#: includes/class-apivro-wp-notify.php:238
msgid "The WhatsApp device is logged out. Scan the QR code again in the NgirimWA dashboard."
msgstr "Perangkat WhatsApp sudah keluar. Scan ulang QR di dashboard NgirimWA."

#: includes/class-apivro-wp-notify.php:239
msgid "This API Key has no device. Create the key from a device in the NgirimWA dashboard."
msgstr "API Key ini tidak terhubung ke perangkat. Buat key dari perangkat di dashboard NgirimWA."

#: includes/class-apivro-wp-notify.php:240
msgid "Monthly message quota is used up."
msgstr "Kuota pesan bulan ini habis."

#: includes/class-apivro-wp-notify.php:241
msgid "Posting to WhatsApp Channel needs the Pro or Enterprise plan."
msgstr "Posting ke Channel WhatsApp butuh paket Pro atau Enterprise."

#: includes/class-apivro-wp-notify.php:242
msgid "Channel not found. The device number must be the owner or an admin of the channel."
msgstr "Channel tidak ditemukan. Nomor perangkat harus pemilik atau admin channel."

#: includes/class-apivro-wp-notify.php:243
msgid "The WhatsApp device is temporarily disconnected."
msgstr "Perangkat WhatsApp sedang terputus sementara."

#: includes/class-apivro-wp-notify.php:244
msgid "Too many requests. NgirimWA asked to slow down."
msgstr "Terlalu banyak permintaan. NgirimWA meminta jeda."

#: includes/class-apivro-wp-notify.php:245
msgid "Could not reach NgirimWA."
msgstr "Tidak bisa menghubungi NgirimWA."

