msgstr "Simpan Pengaturan"

#: includes/class-apivro-wp-notify-admin.php:410
msgid "Tools"
msgstr "Alat"

#: includes/class-apivro-wp-notify-admin.php:411
msgid "Save the settings before using these tools."
msgstr "Simpan pengaturan sebelum memakai alat berikut."

#: includes/class-apivro-wp-notify-admin.php:413
