msgstr "Gagal"

#: includes/class-apivro-wp-notify-admin.php:357
msgid "Paused"
msgstr "Dijeda"

#: includes/class-apivro-wp-notify-admin.php:358
msgid "Skipped"
msgstr "Dilewati"

#: includes/class-apivro-wp-notify-admin.php:361
msgid "Recent Activity"
msgstr "Aktivitas Terakhir"

#: includes/class-apivro-wp-notify-admin.php:363
