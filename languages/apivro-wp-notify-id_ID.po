#: includes/class-apivro-wp-notify-admin.php:60
msgid "APIvro WP Notify Settings"
msgstr "Pengaturan APIvro WP Notify"

#: includes/class-apivro-wp-notify-admin.php:61
msgid "APIvro WP Notify"
msgstr "APIvro WP Notify"

#: includes/class-apivro-wp-notify-admin.php:117
msgid "Configuration"
msgstr "Konfigurasi"

#: includes/class-apivro-wp-notify-admin.php:124
msgid "API Key"
msgstr "Kunci API"

#: includes/class-apivro-wp-notify-admin.php:132
msgid "WA Numbers / Group IDs"
msgstr "Nomor WA / ID Grup"

#: includes/class-apivro-wp-notify-admin.php:140
msgid "Body Text"
msgstr "Teks Body"

#: includes/class-apivro-wp-notify-admin.php:148
msgid "Footer Text"
msgstr "Teks Footer"

#: includes/class-apivro-wp-notify-admin.php:156
msgid "Delay"
msgstr "Tunda"

#: includes/class-apivro-wp-notify-admin.php:174
msgid "Configure your APIvro API settings below. After saving, notifications will be sent automatically when a post is published."
msgstr "Konfigurasikan pengaturan API APIvro Anda di bawah ini. Setelah disimpan, notifikasi akan dikirim otomatis ketika postingan diterbitkan."

#: includes/class-apivro-wp-notify-admin.php:186
msgid "Enter your APIvro API Key"
msgstr "Masukkan Kunci API APIvro Anda"

#: includes/class-apivro-wp-notify-admin.php:190
msgid "Current key: "
msgstr "Kunci saat ini: "

#: includes/class-apivro-wp-notify-admin.php:194
msgid "Enter your APIvro API Key. You can get your API key from your APIvro dashboard."
msgstr "Masukkan Kunci API APIvro Anda. Anda dapat memperoleh kunci API dari dashboard APIvro Anda."

#: includes/class-apivro-wp-notify-admin.php:213
msgid "628123456789,123456789289524319@g.us"
msgstr "628123456789,123456789289524319@g.us"

#: includes/class-apivro-wp-notify-admin.php:215
msgid "Enter WhatsApp numbers or Group IDs, separated by commas (without spaces). Each recipient will receive the notification. Example: 628123456789,123456789289524319@g.us"
msgstr "Masukkan nomor WhatsApp atau ID Grup, dipisahkan dengan koma (tanpa spasi). Setiap penerima akan menerima notifikasi. Contoh: 628123456789,123456789289524319@g.us"

#: includes/class-apivro-wp-notify-admin.php:231
msgid "Use Excerpt"
msgstr "Gunakan Ringkasan"

#: includes/class-apivro-wp-notify-admin.php:240
msgid "Custom"
msgstr "Kustom"

#: includes/class-apivro-wp-notify-admin.php:249
msgid "Enter custom body text that will appear before the post link. This text will be used for all notifications. Leave empty to disable. Example: Baca selengkapnya 👇👇"
msgstr "Masukkan teks body kustom yang akan muncul sebelum link postingan. Teks ini akan digunakan untuk semua notifikasi. Kosongkan untuk menonaktifkan. Contoh: Baca selengkapnya 👇👇"

#: includes/class-apivro-wp-notify-admin.php:263
msgid "Enter custom footer text that will appear after the post link. Leave empty to disable. You can use line breaks - they will be preserved in the WhatsApp message."
msgstr "Masukkan teks footer kustom yang akan muncul setelah link postingan. Kosongkan untuk menonaktifkan. Anda dapat menggunakan baris baru - mereka akan dipertahankan dalam pesan WhatsApp."

#: includes/class-apivro-wp-notify-admin.php:279
msgid "Smart Delay"
msgstr "Tunda Cerdas"

#: includes/class-apivro-wp-notify-admin.php:288
msgid "Custom"
msgstr "Kustom"

#: includes/class-apivro-wp-notify-admin.php:299
msgid "seconds"
msgstr "detik"

#: includes/class-apivro-wp-notify-admin.php:301
msgid "Enter delay in seconds between each message send. Recommended: 2-5 seconds to avoid being banned."
msgstr "Masukkan tunda dalam detik antara setiap pengiriman pesan. Direkomendasikan: 2-5 detik untuk menghindari banned."

#: includes/class-apivro-wp-notify-admin.php:304
msgid "Smart Delay: Random delay between 2-5 seconds. Custom: Fixed delay as specified."
msgstr "Tunda Cerdas: Tunda acak antara 2-5 detik. Kustom: Tunda tetap sesuai yang ditentukan."

#: includes/class-apivro-wp-notify-admin.php:297
msgid "Settings saved successfully."
msgstr "Pengaturan berhasil disimpan."

#: includes/class-apivro-wp-notify-admin.php:333
msgid "Save Settings"
msgstr "Simpan Pengaturan"

